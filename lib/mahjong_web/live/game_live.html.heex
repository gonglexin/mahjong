<Layouts.app flash={@flash}>
  <div class="table-shell">
    <header class="table-head">
      <div class="brand-seal" aria-hidden="true">雀</div>
      <div class="brand-word">MAHJONG<small>雀馆</small></div>
      <div class="guide-words">
        <%= cond do %>
          <% @phase == :playing -> %>
            <span class="gw-live">
              {if(@turn_position,
                do: "#{position_label(@turn_position)}家出牌",
                else: "等待行动"
              )}
            </span>
            <span class="gw-sep"></span>
            <span>余牌 {@tile_size}</span>
          <% @phase == :over -> %>
            <span>终局</span>
          <% true -> %>
            <span>候局</span>
        <% end %>
      </div>
      <%!-- 音效开关：静音状态由前端 hook 持有，服务端不参与 --%>
      <div id="sound-fx" phx-hook="SoundFX" phx-update="ignore">
        <button
          id="sound-toggle"
          type="button"
          class="sound-toggle"
          data-sound-toggle
          aria-label="音效开关"
        >
          <.icon name="hero-speaker-wave" class="sound-icon sound-icon-on" />
          <.icon name="hero-speaker-x-mark" class="sound-icon sound-icon-off" />
        </button>
      </div>
      <.link patch={~p"/"} class="link-brass">回大厅</.link>
    </header>

    <main id="game-board" class="table-felt">
      <%!-- 中央：装饰艺术罗盘、风位与余牌 --%>
      <div id="position_marker" class="compass" aria-hidden="true">
        <svg viewBox="0 0 240 240" class="absolute inset-0 h-full w-full" fill="none">
          <circle cx="120" cy="120" r="115" class="ring" />
          <circle cx="120" cy="120" r="86" class="ring" />
          <%= for i <- 0..23 do %>
            <line
              x1="120"
              y1={120 - if(rem(i, 6) == 0, do: 86, else: 100)}
              x2="120"
              y2={120 - 114}
              class={if(rem(i, 6) == 0, do: "ray ray-major", else: "ray")}
              transform={"rotate(#{i * 15} 120 120)"}
            />
          <% end %>
        </svg>

        <div class="compass-grid">
          <span></span>
          <span class={
            wind_chip_class(compass_seats(@current_player.position).top, @turn_position)
          }>
            {position_label(compass_seats(@current_player.position).top)}
          </span>
          <span></span>
          <span class={
            wind_chip_class(compass_seats(@current_player.position).left, @turn_position)
          }>
            {position_label(compass_seats(@current_player.position).left)}
          </span>
          <span class="wall-hub">
            <span class={["wall-count", @tile_size <= 8 && "wall-count-low"]}>{@tile_size}</span>
            <span class="wall-label">余牌</span>
          </span>
          <span class={
            wind_chip_class(compass_seats(@current_player.position).right, @turn_position)
          }>
            {position_label(compass_seats(@current_player.position).right)}
          </span>
          <span></span>
          <span class={
            wind_chip_class(compass_seats(@current_player.position).bottom, @turn_position)
          }>
            {position_label(compass_seats(@current_player.position).bottom)}
          </span>
          <span></span>
        </div>
      </div>

      <div id="players" phx-update="stream">
        <div
          :for={{id, player} <- @streams.players}
          id={id}
          class={["seat", seat_class(player, @current_player)]}
          data-position={seat_position(player, @current_player)}
        >
          <%!-- 弃牌（朝桌心） --%>
          <div class="discards">
            <.tile
              :for={tile <- player.discards}
              id={tile.id}
              tile={tile}
              show={true}
              class="tile-discard"
            />
          </div>

          <%!-- 手牌行：副露紧贴手牌一侧 --%>
          <div class="hand-row">
            <div class="melds">
              <div :for={meld <- player.open_hand} class="meld">
                <.tile
                  :for={{copy, i} <- Enum.with_index(meld.tiles)}
                  id={"#{copy.id}-c#{i}"}
                  tile={copy}
                  show={true}
                  class="tile-discard"
                />
              </div>
            </div>

            <div class="hand">
              <.tile
                :for={{tile, is_drawn} <- hand_tiles(player)}
                id={tile.id}
                tile={tile}
                show={@current_player.id == player.id or @phase == :over}
                class={[
                  "tile-hand",
                  is_drawn && "tile-drawn",
                  @current_player.id == player.id && @phase == :playing &&
                    "tile-hand-interactive"
                ]}
                tabindex={
                  if(@current_player.id == player.id && player.in_turn? && @phase == :playing,
                    do: "0"
                  )
                }
                role={
                  if(@current_player.id == player.id && player.in_turn? && @phase == :playing,
                    do: "button"
                  )
                }
                phx-click={
                  if @current_player.id == player.id && player.in_turn? && @phase == :playing,
                    do: "discard"
                }
                phx-keydown={
                  if(@current_player.id == player.id && player.in_turn? && @phase == :playing,
                    do: "discard"
                  )
                }
                phx-key={
                  if(@current_player.id == player.id && player.in_turn? && @phase == :playing,
                    do: "Enter"
                  )
                }
                phx-value-id={tile.id}
              />
            </div>
          </div>

          <%!-- 玩家铭牌 --%>
          <div class={[
            "seat-id",
            @phase == :playing && player.position == @turn_position && "seat-id-turn"
          ]}>
            <span class="wind-glyph">{position_label(player.position)}</span>
            <.avatar name={player.token || player.id} class="seat-avatar" />
            <span>
              {Player.persona_label(player.persona) ||
                String.slice(player.token || player.id, 0, 8)}
            </span>
            <span :if={player.position == @dealer} class="dealer-tag">庄</span>
          </div>
        </div>
      </div>

      <%!-- 候局：入席牌位 --%>
      <div :if={@phase == :waiting} class="opening-plate">
        <div class="opening-title">入席</div>
        <div class="opening-row">
          <button :if={is_nil(@current_player.game_id)} class="act act-primary" phx-click="join">
            入座
          </button>
          <button class="act act-primary" phx-click="start">开局</button>
        </div>
        <div class="opening-row">
          <button
            :for={{persona, info} <- Player.personas()}
            class="chip-brass"
            phx-click="add_ai"
            phx-value-persona={persona}
          >
            +AI {info.name}（{info.label}）
          </button>
        </div>
        <div class="opening-credit">
          <Layouts.author_links />
        </div>
      </div>

      <%!-- 报牌动作：吃/碰/杠按钮带迷你牌面；声明后变暗等待结算 --%>
      <div
        :if={@action_buttons != [] and @phase == :playing}
        class={["action-fan", @claim_sent && "claim-sent"]}
      >
        <div class="fan-buttons">
          <button
            :for={button <- @action_buttons}
            class={["act", button.class]}
            phx-click="action"
            phx-value-action={button.value}
          >
            <span class="act-tag">{button.label}</span>
            <span :if={button.tiles != []} class="act-tiles">
              <.tile :for={t <- button.tiles} tile={t} show={true} class="tile-mini" />
            </span>
          </button>
        </div>
        <div :if={@claim_sent} class="fan-hint">已声明 · 等待结算</div>
      </div>

      <%!-- 等待提示：有人在报牌窗口中决策 --%>
      <div
        :if={@waiting_others and @action_buttons == [] and @phase == :playing}
        class="waiting-note"
      >
        等待其他玩家行动…
      </div>

      <%!-- 结算 --%>
      <div :if={@phase == :over} class="result-overlay">
        <div class="result-plate">
          <%= if @result && @result.type == :wall_empty do %>
            <div class="seal-draw">荒庄</div>
            <div class="result-title">流局</div>
            <div class="result-meta">牌墙已空</div>
          <% else %>
            <div class="seal-win">胡</div>
            <div class="result-title">
              {@result && ((@result.type == :self_win && "自摸") || "胡牌")}
            </div>
            <div class="result-meta">
              胡家 {String.slice((@result && Map.get(@result, :winner_id)) || "", 0, 8)}
              <span :if={@result && @result[:loser_id]}>
                · 放炮 {String.slice(@result.loser_id, 0, 8)}
              </span>
            </div>
            <div class="result-fans">{@result && fan_names(@result.fans)}</div>
            <div class="result-score">{@result && @result.score} 番</div>
          <% end %>
          <div class="result-actions">
            <button class="act act-primary" phx-click="restart">再来一局</button>
          </div>
        </div>
      </div>
    </main>
  </div>
</Layouts.app>
